{
  "name": "solidtime-clickup-bridge",
  "description": "Unofficial browser extension: one-click Solidtime timers from ClickUp tasks",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "E2E=1 wxt build && playwright test",
    "test:live": "E2E=1 wxt build && playwright test --config playwright.live.config.ts",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "postinstall": "wxt prepare",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "check-manifest": "tsx scripts/check-release-manifest.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  }
}
